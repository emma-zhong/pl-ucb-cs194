# Copy this file to .devcontainer/.env (Git-ignored). Never commit real values.
#
# PrairieLearn generates SQL through the English-to-SQL proxy, which holds the OpenAI
# key. Run it with `npm run dev` in proxy/ (see proxy/README.md) and use the same
# COURSE_TOKEN as in proxy/.dev.vars.
ENGLISH_TO_SQL_PROXY_TOKEN=replace-with-the-proxy-course-token

# Optional. The default URL reaches a proxy running on this computer.
# ENGLISH_TO_SQL_PROXY_URL=http://host.docker.internal:8787
# The model must be in the proxy's ALLOWED_MODELS.
# ENGLISH_TO_SQL_MODEL=gpt-4.1-mini
